# Copy to .env (gitignored) and fill in. Vite only exposes VITE_-prefixed vars
# to the client, and everything here is client-side by design — the publishable
# key is safe to ship, since RLS is what actually guards the data.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Dev-only editor quick-login (optional) ---------------------------------
# Anonymous visitors are read-only viewers, so testing ANY edit-gated surface
# needs a genuine non-anonymous session. Setting these two enables
# window.__devSignIn() in the browser console (see src/auth.tsx); it is
# compiled out of production builds by an import.meta.env.DEV guard.
#
# The account is a throwaway that exists only in the remote Supabase project —
# nothing in this repo creates it, so it goes stale whenever it's deleted or
# its password rotates. Provisioning is two steps, and the second is the one
# people miss:
#
#   1. Dashboard → Authentication → Users → Add user. Use the email and
#      password below and tick "Auto Confirm User" — an unconfirmed account
#      fails with email_not_confirmed, which reads like an unrelated bug.
#
#   2. Give it write access to the campaign under test. Since migration 0023
#      writes require a campaign_members row, and that table is deny-all for
#      client writes (0018/0022) — only create_campaign or
#      redeem_campaign_invite can grant it. So either redeem an invite as this
#      user, or run in the dashboard SQL editor:
#
#        insert into campaign_members (campaign_id, user_id, role)
#        select '<campaign-id>', id, 'dm' from auth.users
#        where email = 'dev-editor@codex.test'
#        on conflict do nothing;
#
#      Skip step 2 and you get a session that passes the canEdit gate but has
#      every write RLS-rejected into the "wasn't saved" toast.
#
# __devSignIn(email, password) also takes overrides, so a single .env can drive
# two throwaway accounts (a DM and an invited player, issue #86).
VITE_DEV_EDITOR_EMAIL=dev-editor@codex.test
VITE_DEV_EDITOR_PASSWORD=
